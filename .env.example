# Copia este archivo a .env y reemplaza los valores.
# IMPORTANTE: tras cambiar .env debes reconstruir:
#   npm run build && npx cap sync android
#
# RevenueCat → Project Settings → API keys → Public app-specific API key (Google Play Store)
# Package name en RevenueCat debe ser: com.guiaespiritualapp.app
VITE_REVENUECAT_ANDROID_KEY=goog_your_android_public_api_key_here
# Solo si publicas en iOS:
# VITE_REVENUECAT_IOS_KEY=appl_your_ios_public_api_key_here
